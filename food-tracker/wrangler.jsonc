{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only the Access-protected custom domain serves this app. No *.workers.dev
  // URL and no preview URLs, so nothing can reach it without going through Access.
  "workers_dev": false,
  "preview_urls": false,

  // Set at deploy time once the subdomain is chosen, e.g.:
  // "routes": [{ "pattern": "food.example.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-tracker",
      // Filled in after `wrangler d1 create food-tracker`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Zero Trust team domain, e.g. "yourteam.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "",
    // Application Audience (AUD) tag from the Access application.
    "ACCESS_AUD": ""
  },

  "observability": { "enabled": true }
}
